# ── TimeCast backend — пример переменных окружения ──
# Скопируйте этот файл в `.env` и подставьте свои значения:
#   cp .env.example .env

# ── Сервер ──
HOST=0.0.0.0
SERVER_PORT=8080
# DEBUG=TRUE включает авто-reload uvicorn (TRUE | FALSE)
DEBUG=TRUE

# ── CORS ──
# Список разрешённых origin через запятую. В проде НЕ используйте "*".
CORS_ORIGINS=http://localhost:3000

# ── Пути к данным и артефактам (относительно корня backend) ──
DATA_PATH=data
UPLOAD_DIR=data
PLOTS_PATH=public/plots
ZIP_PATH=public/zip
WEIGHTS_CLASSIC_PATH=weights/classic
WEIGHTS_NEIRO_PATH=weights/neiro
