# ===== TimeCast — переменные окружения (Docker) =====
# Скопируйте в .env.dev / .env.prod и подставьте свои значения. Секреты НЕ коммитить.

# --- Режим / образы ---
MODE=dev
APP_TAG=latest
APP_DOCKERHUB_REPO=deneal123

# --- Порты (хост) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
APP_DOMAIN=localhost

# --- Backend (FastAPI) ---
HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=TRUE                 # TRUE = uvicorn --reload (dev); FALSE (prod)
CORS_ORIGINS=http://localhost:3000
UVICORN_WORKERS=1          # >1 требует Redis-backed TaskStore (иначе задачи видны только одному процессу)

# LOG_FILE=logs/app.log               # опционально: путь к лог-файлу (иначе только stdout)

# Пути данных/артефактов внутри контейнера backend
DATA_PATH=data
UPLOAD_DIR=data
PLOTS_PATH=public/plots
ZIP_PATH=public/zip
WEIGHTS_CLASSIC_PATH=weights/classic
WEIGHTS_NEIRO_PATH=weights/neiro

# --- Frontend ---
REACT_APP_API_BASE_URL=http://localhost:8000/server

# --- Postgres (инфраструктура; backend пока не использует напрямую) ---
PG__USER=timecast
PG__PASSWORD=change-me-postgres
PG__DB=timecast
PG__PORT=5432

# --- Redis ---
REDIS__PASSWORD=change-me-redis

# --- MinIO (S3-совместимое хранилище) ---
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- S3-артефакты (веса, графики) — MinIO, Selectel, AWS или любой S3-совместимый ---
# Если S3_ENDPOINT или S3_BUCKET не заданы — загрузка артефактов отключена.
S3_ENDPOINT=http://minio:9000       # внутри Docker; снаружи: http://localhost:9000
S3_BUCKET=timecast-artifacts
S3_ACCESS_KEY=minioadmin             # совпадает с MINIO__ACCESS_KEY для встроенного MinIO
S3_SECRET_KEY=change-me-minio
S3_REGION=us-east-1                  # для MinIO/Selectel — любое значение

# --- Celery (только за профилем `celery`; требует celery-app, пока не реализован) ---
CELERY__BROKER_URL=redis://:change-me-redis@redis:6379/0
CELERY__RESULT_BACKEND=redis://:change-me-redis@redis:6379/1
